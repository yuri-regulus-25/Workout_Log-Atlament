{
  "name": "workout-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "src/frontend/*",
    "src/shared/*"
  ],
  "scripts": {
    "build": "npm run build:apps && npm run build:mpa",
    "build:apps": "node src/frontend/portal/build.mjs && node src/frontend/errors/build.mjs && npm run build -w @workout-lab/workouts-vue && npm run build -w @workout-lab/dashboard-react && npm run build -w @workout-lab/machines-angular && npm run build -w @workout-lab/analytics-svelte && npm run build -w @workout-lab/settings-solid && npm run build -w @workout-lab/maintenance-vue",
    "build:mpa": "node tools/build/build-mpa.mjs",
    "check:analytics": "npm run check -w @workout-lab/analytics-svelte",
    "check:all": "npm run version:check && npm run check:analytics && npm run check:data && npm run check:mpa",
    "check:data": "vitest run src/shared/workout-data/src/real-data.test.ts",
    "check:mpa": "node tools/validation/check-mpa.mjs",
    "dev:analytics": "node tools/dev-runtime/dev-with-workout-data.mjs npm run dev -w @workout-lab/analytics-svelte",
    "dev:dashboard": "node tools/dev-runtime/dev-with-workout-data.mjs npm run dev -w @workout-lab/dashboard-react",
    "dev:machines": "node tools/dev-runtime/dev-with-workout-data.mjs npm run start -w @workout-lab/machines-angular",
    "dev:runtime": "node tools/dev-runtime/development-runtime.mjs",
    "dev:settings": "npm run dev -w @workout-lab/settings-solid",
    "dev:maintenance": "node tools/dev-runtime/dev-with-workout-data.mjs npm run dev -w @workout-lab/maintenance-vue",
    "dev:workouts": "node tools/dev-runtime/dev-with-workout-data.mjs npm run dev -w @workout-lab/workouts-vue",
    "prod:analytics": "npm run prod -w @workout-lab/analytics-svelte",
    "prod:dashboard": "npm run prod -w @workout-lab/dashboard-react",
    "prod:machines": "npm run prod -w @workout-lab/machines-angular",
    "prod:settings": "npm run prod -w @workout-lab/settings-solid",
    "prod:maintenance": "npm run prod -w @workout-lab/maintenance-vue",
    "prod:workouts": "npm run prod -w @workout-lab/workouts-vue",
    "preview:mpa": "node tools/dev-runtime/preview-mpa.mjs",
    "test": "vitest run",
    "version:check": "node tools/version/atlament-version.mjs check",
    "version:set": "node tools/version/atlament-version.mjs set",
    "watch": "node tools/dev-runtime/watch.mjs",
    "watch:analytics": "npm run dev -w @workout-lab/analytics-svelte -- --host 127.0.0.1 --port 5178 --strictPort",
    "watch:dashboard": "npm run dev -w @workout-lab/dashboard-react -- --host 127.0.0.1 --port 5175 --strictPort",
    "watch:machines": "npm run start -w @workout-lab/machines-angular -- --host 127.0.0.1 --port 5177 --serve-path /machines/",
    "watch:portal": "node tools/dev-runtime/watch-portal.mjs",
    "watch:settings": "npm run dev -w @workout-lab/settings-solid -- --host 127.0.0.1 --port 5179 --strictPort",
    "watch:maintenance": "npm run dev -w @workout-lab/maintenance-vue -- --host 127.0.0.1 --port 5181 --strictPort",
    "watch:workouts": "npm run dev -w @workout-lab/workouts-vue -- --host 127.0.0.1 --port 5176 --strictPort",
    "build:windows": "node tools/build/build-windows.mjs",
    "build:android": "npm run build && node tools/build/build-android.mjs",
    "build:android:release": "npm run build && node tools/build/build-android-release.mjs"
  },
  "devDependencies": {
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47"
  }
}

