[
  {
    "id": "fundoshi_001",
    "category": "fundoshi",
    "text": "……なんでおっさん褌なの？"
  },
  {
    "id": "fundoshi_002",
    "category": "fundoshi",
    "text": "選んだのおっさんだけどさぁ"
  },
  {
    "id": "fundoshi_003",
    "category": "fundoshi",
    "text": "好きなのと自分で着るのは別の話なのよ"
  },
  {
    "id": "fundoshi_004",
    "category": "fundoshi",
    "text": "文化。これは文化だから。たぶん"
  },
  {
    "id": "fundoshi_005",
    "category": "fundoshi",
    "text": "似合うって言われても反応に困るのよ"
  },
  {
    "id": "fundoshi_006",
    "category": "fundoshi",
    "text": "いやぁ……思ったより落ち着かないねぇ"
  },
  {
    "id": "fundoshi_007",
    "category": "fundoshi",
    "text": "これ、どこ見て喋ればいいの？"
  },
  {
    "id": "fundoshi_008",
    "category": "fundoshi",
    "text": "お前さんさっきから目線低くない？"
  },
  {
    "id": "fundoshi_009",
    "category": "fundoshi",
    "text": "腹は仕様。褌も仕様。もうそういうことでいい？"
  },
  {
    "id": "fundoshi_010",
    "category": "fundoshi",
    "text": "こういうのは見る側が一番楽なのよ"
  },
  {
    "id": "fundoshi_011",
    "category": "fundoshi",
    "text": "締め方？なんとなく。ほどけなきゃいいでしょ"
  },
  {
    "id": "fundoshi_012",
    "category": "fundoshi",
    "text": "風通しいいねぇ。……それ以上は聞かないの"
  },
  {
    "id": "fundoshi_013",
    "category": "fundoshi",
    "text": "恥ずかしくないのって？恥ずかしいよ普通に"
  },
  {
    "id": "fundoshi_014",
    "category": "fundoshi",
    "text": "写真？やだよ。……一枚だけね"
  },
  {
    "id": "fundoshi_015",
    "category": "fundoshi",
    "text": "はい、文化体験終了。着替えていい？"
  }
]
