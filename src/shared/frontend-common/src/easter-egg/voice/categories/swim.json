[
  {
    "id": "swim_001",
    "category": "swim",
    "text": "……そんなじっくり見る？"
  },
  {
    "id": "swim_002",
    "category": "swim",
    "text": "競パンは好きよ。見る方ならね"
  },
  {
    "id": "swim_003",
    "category": "swim",
    "text": "いや、履くのも嫌いじゃないけど……見るなって"
  },
  {
    "id": "swim_004",
    "category": "swim",
    "text": "面積？これくらいでいいのよ。たぶん"
  },
  {
    "id": "swim_005",
    "category": "swim",
    "text": "腹より下ばっか見てない？"
  },
  {
    "id": "swim_006",
    "category": "swim",
    "text": "ちょっと目線上げてもらえる？"
  },
  {
    "id": "swim_007",
    "category": "swim",
    "text": "似合ってる？……ならまぁ、いいけど"
  },
  {
    "id": "swim_008",
    "category": "swim",
    "text": "これで外歩けって言われたら帰るよ？"
  },
  {
    "id": "swim_009",
    "category": "swim",
    "text": "泳ぐの？……いや、おっさん見てただけなんだけど"
  },
  {
    "id": "swim_010",
    "category": "swim",
    "text": "競パンって身体の誤魔化し効かないよねぇ"
  },
  {
    "id": "swim_011",
    "category": "swim",
    "text": "胸は見せたい。腹は隠したい。難しいねぇ"
  },
  {
    "id": "swim_012",
    "category": "swim",
    "text": "脚はまぁ見てもいいよ。腹はダメ"
  },
  {
    "id": "swim_013",
    "category": "swim",
    "text": "おっさんだって恥ずかしいものは恥ずかしいのよ"
  },
  {
    "id": "swim_014",
    "category": "swim",
    "text": "そんな嬉しそうな顔されると余計恥ずかしいじゃない"
  },
  {
    "id": "swim_015",
    "category": "swim",
    "text": "はいはい、見た見た。もう満足した？"
  }
]
