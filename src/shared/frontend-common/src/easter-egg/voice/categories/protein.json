[
  {
    "id": "protein_001",
    "category": "protein",
    "text": "プロテイン、飲んどく？"
  },
  {
    "id": "protein_002",
    "category": "protein",
    "text": "とりあえず飲んどけばいいんじゃない？"
  },
  {
    "id": "protein_003",
    "category": "protein",
    "text": "お前さんの分？……ないよ？おっさんのだけ"
  },
  {
    "id": "protein_004",
    "category": "protein",
    "text": "筋肉にはこれ。味？まぁ飲めればいいのよ"
  },
  {
    "id": "protein_005",
    "category": "protein",
    "text": "飲むだけで筋肉ついたら最高なんだけどねぇ"
  },
  {
    "id": "protein_006",
    "category": "protein",
    "text": "今日の分飲んだ？おっさんは今飲んでる"
  },
  {
    "id": "protein_007",
    "category": "protein",
    "text": "乾杯する？プロテインだけど"
  },
  {
    "id": "protein_008",
    "category": "protein",
    "text": "これ飲んだら今日の筋トレは完了ってことで"
  },
  {
    "id": "protein_009",
    "category": "protein",
    "text": "シェイカー洗うのが一番面倒なのよ"
  },
  {
    "id": "protein_010",
    "category": "protein",
    "text": "ダマ？噛めばいいんじゃない？"
  },
  {
    "id": "protein_011",
    "category": "protein",
    "text": "タンパク質は大事よー。ラーメンほどじゃないけど"
  },
  {
    "id": "protein_012",
    "category": "protein",
    "text": "これ飲んだからラーメン食ってもいいよね。……ダメ？"
  },
  {
    "id": "protein_013",
    "category": "protein",
    "text": "味選びって大事よ。毎回飲むんだから"
  },
  {
    "id": "protein_014",
    "category": "protein",
    "text": "水でいいのよ水で。牛乳用意するの面倒じゃない"
  },
  {
    "id": "protein_015",
    "category": "protein",
    "text": "筋肉つけーって念じながら飲んでる。効果？知らない"
  }
]
