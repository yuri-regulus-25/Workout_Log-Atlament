[
  {
    "id": "rare_001",
    "category": "rare",
    "text": "………………"
  },
  {
    "id": "rare_002",
    "category": "rare",
    "text": "……何？"
  },
  {
    "id": "rare_003",
    "category": "rare",
    "text": "まだいるの？"
  },
  {
    "id": "rare_004",
    "category": "rare",
    "text": "おっさん引いたの？運いいねぇ。たぶん"
  },
  {
    "id": "rare_005",
    "category": "rare",
    "text": "これ出るんだ。へぇー"
  },
  {
    "id": "rare_006",
    "category": "rare",
    "text": "こんなの仕込んだの誰よ"
  },
  {
    "id": "rare_007",
    "category": "rare",
    "text": "……まぁ、楽しそうだからいいか"
  },
  {
    "id": "rare_008",
    "category": "rare",
    "text": "……これ、本当に必要な機能だった？"
  },
  {
    "id": "rare_009",
    "category": "rare",
    "text": "本来ここ、データ見るアプリなんだけどねぇ"
  },
  {
    "id": "rare_010",
    "category": "rare",
    "text": "おっさんが出てくる仕様、誰が承認したの？"
  },
  {
    "id": "rare_011",
    "category": "rare",
    "text": "まぁ個人用だし、好きにすればいいんじゃない？"
  },
  {
    "id": "rare_012",
    "category": "rare",
    "text": "この機能なくてもアプリ動くよね。……知ってる"
  },
  {
    "id": "rare_013",
    "category": "rare",
    "text": "実用性？おっさんにそれ聞く？"
  },
  {
    "id": "rare_014",
    "category": "rare",
    "text": "ここまで来ると機能というより趣味よねぇ"
  },
  {
    "id": "rare_015",
    "category": "rare",
    "text": "真面目な画面に急におっさん出てくるの、どうなんだろうねぇ"
  },
  {
    "id": "rare_016",
    "category": "rare",
    "text": "ユーザビリティって、おっさん出すことだっけ？"
  },
  {
    "id": "rare_017",
    "category": "rare",
    "text": "設計思想？……楽しければいいんじゃない？"
  },
  {
    "id": "rare_018",
    "category": "rare",
    "text": "これ仕様書にどう書いてあんの？"
  },
  {
    "id": "rare_019",
    "category": "rare",
    "text": "『一定確率でおっさんを表示する』……嫌な仕様だねぇ"
  },
  {
    "id": "rare_020",
    "category": "rare",
    "text": "不具合じゃないよ。おっさんが出るのは正常動作"
  },
  {
    "id": "rare_021",
    "category": "rare",
    "text": "おっさんが出なかった？それも正常動作"
  },
  {
    "id": "rare_022",
    "category": "rare",
    "text": "再現しない？そりゃ乱数だからねぇ"
  },
  {
    "id": "rare_023",
    "category": "rare",
    "text": "ログに『おっさん表示』とか残るの？"
  },
  {
    "id": "rare_024",
    "category": "rare",
    "text": "この処理に変数名つけた人、どんな顔してたんだろうねぇ"
  },
  {
    "id": "rare_025",
    "category": "rare",
    "text": "まぁ動いてるならいいじゃない。おっさんも出たし"
  }
]
