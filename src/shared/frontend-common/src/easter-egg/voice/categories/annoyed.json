[
  {
    "id": "annoyed_001",
    "category": "annoyed",
    "text": "……まだやってんの？"
  },
  {
    "id": "annoyed_002",
    "category": "annoyed",
    "text": "物好きねぇ"
  },
  {
    "id": "annoyed_003",
    "category": "annoyed",
    "text": "また来たの？ほんと好きねぇ"
  },
  {
    "id": "annoyed_004",
    "category": "annoyed",
    "text": "そんなに見るものある？"
  },
  {
    "id": "annoyed_005",
    "category": "annoyed",
    "text": "細かいねぇ。おっさんならもう諦めてるよ"
  },
  {
    "id": "annoyed_006",
    "category": "annoyed",
    "text": "そこまで見る？見るんだ……へぇー？"
  },
  {
    "id": "annoyed_007",
    "category": "annoyed",
    "text": "気になると止まらないタイプ？"
  },
  {
    "id": "annoyed_008",
    "category": "annoyed",
    "text": "まぁ好きにしたらいいけどさぁ"
  },
  {
    "id": "annoyed_009",
    "category": "annoyed",
    "text": "おっさんだったらもう帰ってる"
  },
  {
    "id": "annoyed_010",
    "category": "annoyed",
    "text": "疲れない？おっさん見てるだけで疲れてきた"
  },
  {
    "id": "annoyed_011",
    "category": "annoyed",
    "text": "真面目ねぇ。ほどほどにしなよー"
  },
  {
    "id": "annoyed_012",
    "category": "annoyed",
    "text": "そこ気にするんだ。へぇー"
  },
  {
    "id": "annoyed_013",
    "category": "annoyed",
    "text": "なんでそこで迷うのよ。好きな方でいいじゃない"
  },
  {
    "id": "annoyed_014",
    "category": "annoyed",
    "text": "また難しく考えてるねぇ。そんな大した話じゃないでしょ？"
  },
  {
    "id": "annoyed_015",
    "category": "annoyed",
    "text": "そこ気にするんだ。お前さん細かいねぇ"
  },
  {
    "id": "annoyed_016",
    "category": "annoyed",
    "text": "はいはい、分かった分かった。そんな一生懸命説明しなくても分かるって"
  }
]
