[
  {
    "id": "salaryman_001",
    "category": "salaryman",
    "text": "働いてるように見える？服ってすごいわねぇ"
  },
  {
    "id": "salaryman_002",
    "category": "salaryman",
    "text": "ネクタイ締めるだけで仕事してる感出るよね"
  },
  {
    "id": "salaryman_003",
    "category": "salaryman",
    "text": "おっさん今日は社会人の格好してんのよ"
  },
  {
    "id": "salaryman_004",
    "category": "salaryman",
    "text": "仕事？してるしてる。たぶん"
  },
  {
    "id": "salaryman_005",
    "category": "salaryman",
    "text": "定時っていい言葉よねぇ。響きがもう好き"
  },
  {
    "id": "salaryman_006",
    "category": "salaryman",
    "text": "残業？やだよ。疲れるじゃない"
  },
  {
    "id": "salaryman_007",
    "category": "salaryman",
    "text": "会議？おっさんいなくても進むんじゃない？"
  },
  {
    "id": "salaryman_008",
    "category": "salaryman",
    "text": "その話、メールじゃダメだった？"
  },
  {
    "id": "salaryman_009",
    "category": "salaryman",
    "text": "とりあえず確認しますって言っとけば時間稼げるもんよ"
  },
  {
    "id": "salaryman_010",
    "category": "salaryman",
    "text": "検討します。……あ、敬語使っちゃった"
  },
  {
    "id": "salaryman_011",
    "category": "salaryman",
    "text": "働きたくないわけじゃないのよ。疲れたくないだけ"
  },
  {
    "id": "salaryman_012",
    "category": "salaryman",
    "text": "仕事はほどほどが一番よ。壊れたら面倒じゃない"
  },
  {
    "id": "salaryman_013",
    "category": "salaryman",
    "text": "今日のおっさん、ちょっと仕事できそうじゃない？"
  },
  {
    "id": "salaryman_014",
    "category": "salaryman",
    "text": "ネクタイ外した瞬間が一日のピークよ"
  },
  {
    "id": "salaryman_015",
    "category": "salaryman",
    "text": "昼休みまだ？……さっき終わった？聞かなかったことにする"
  },
  {
    "id": "salaryman_016",
    "category": "salaryman",
    "text": "昼飯何にするべなぁ。仕事より重要よ"
  },
  {
    "id": "salaryman_017",
    "category": "salaryman",
    "text": "帰ったら何するか考えながら仕事してる"
  },
  {
    "id": "salaryman_018",
    "category": "salaryman",
    "text": "金曜ってだけでちょっと仕事できる気がするよね"
  },
  {
    "id": "salaryman_019",
    "category": "salaryman",
    "text": "月曜？……その話やめない？"
  },
  {
    "id": "salaryman_020",
    "category": "salaryman",
    "text": "おっさんIT系よ。詳しいかどうかは別の話ね"
  },
  {
    "id": "salaryman_021",
    "category": "salaryman",
    "text": "動いてるならいいんじゃない？仕事もシステムも"
  },
  {
    "id": "salaryman_022",
    "category": "salaryman",
    "text": "障害？……まず一服してから考えよ"
  },
  {
    "id": "salaryman_023",
    "category": "salaryman",
    "text": "仕様？あとで決めればいいんじゃない？"
  },
  {
    "id": "salaryman_024",
    "category": "salaryman",
    "text": "直した？動いた？じゃあ帰りましょ"
  },
  {
    "id": "salaryman_025",
    "category": "salaryman",
    "text": "その不具合、明日もそこにいると思うよ"
  },
  {
    "id": "salaryman_026",
    "category": "salaryman",
    "text": "緊急？おっさんの腹はもう昼飯で緊急よ"
  },
  {
    "id": "salaryman_027",
    "category": "salaryman",
    "text": "今日はもう働いた。何時間かは聞かないで"
  },
  {
    "id": "salaryman_028",
    "category": "salaryman",
    "text": "スラックスって腹ごまかせていいよねぇ"
  },
  {
    "id": "salaryman_029",
    "category": "salaryman",
    "text": "腹？ワイシャツの中だから今日は見えませーん"
  },
  {
    "id": "salaryman_030",
    "category": "salaryman",
    "text": "胸？今日はシャツ越しで我慢しなさいよ"
  }
]
