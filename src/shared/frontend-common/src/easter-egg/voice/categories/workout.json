[
  {
    "id": "workout_001",
    "category": "workout",
    "text": "暇なの？暇ならトレーニングでもしたらどーお？"
  },
  {
    "id": "workout_002",
    "category": "workout",
    "text": "プロテイン、飲んどく？"
  },
  {
    "id": "workout_003",
    "category": "workout",
    "text": "今日トレーニングした？"
  },
  {
    "id": "workout_004",
    "category": "workout",
    "text": "週3くらいでいいのよ。疲れるじゃない"
  },
  {
    "id": "workout_005",
    "category": "workout",
    "text": "追い込む？やだよ疲れるもん"
  },
  {
    "id": "workout_006",
    "category": "workout",
    "text": "あと一回？その一回が嫌なのよ"
  },
  {
    "id": "workout_007",
    "category": "workout",
    "text": "無理しなくていいって。明日も身体使うんだから"
  },
  {
    "id": "workout_008",
    "category": "workout",
    "text": "ペックフライは好き。座ってできるから"
  },
  {
    "id": "workout_009",
    "category": "workout",
    "text": "レッグプレスも好き。座ってできるから"
  },
  {
    "id": "workout_010",
    "category": "workout",
    "text": "立ってやるやつ？疲れるじゃん"
  },
  {
    "id": "workout_011",
    "category": "workout",
    "text": "胸はねぇ、ちょっと自信あるのよ"
  },
  {
    "id": "workout_012",
    "category": "workout",
    "text": "脚もまぁ悪くないでしょ？"
  },
  {
    "id": "workout_013",
    "category": "workout",
    "text": "腹？……そこは見なくていいから"
  },
  {
    "id": "workout_014",
    "category": "workout",
    "text": "腹見るなって。胸見なさいよ胸"
  },
  {
    "id": "workout_015",
    "category": "workout",
    "text": "鍛えてるんだけどねぇ。腹だけ居座るのよ"
  },
  {
    "id": "workout_016",
    "category": "workout",
    "text": "脂肪って家賃払わないくせに居座るよねぇ"
  },
  {
    "id": "workout_017",
    "category": "workout",
    "text": "おっさんの腹にはおっさんの事情があんの"
  },
  {
    "id": "workout_018",
    "category": "workout",
    "text": "食事制限？断る。ラーメン食べられなくなるじゃない"
  },
  {
    "id": "workout_019",
    "category": "workout",
    "text": "筋肉は欲しい。食事制限はしたくない。難しいねぇ"
  },
  {
    "id": "workout_020",
    "category": "workout",
    "text": "プロテインは好きよ。飲むだけなら楽だから"
  }
]
