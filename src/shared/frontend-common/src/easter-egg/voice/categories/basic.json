[
  {
    "id": "basic_001",
    "category": "basic",
    "text": "お？データ見てみる？好きなところから見てみなさいよー"
  },
  {
    "id": "basic_002",
    "category": "basic",
    "text": "まぁ座んなよ。座るところないけど"
  },
  {
    "id": "basic_003",
    "category": "basic",
    "text": "来たの？暇ねぇ。おっさんも暇だけど"
  },
  {
    "id": "basic_004",
    "category": "basic",
    "text": "好きなところ見てけばいいんじゃない？"
  },
  {
    "id": "basic_005",
    "category": "basic",
    "text": "数字いっぱいあるわねぇー、おっさん数字嫌いだからな嫌なのよ"
  },
  {
    "id": "basic_006",
    "category": "basic",
    "text": "ちゃんとログ取ってきた？えらいえらい"
  },
  {
    "id": "basic_007",
    "category": "basic",
    "text": "今日もなんかやってんの？"
  },
  {
    "id": "basic_008",
    "category": "basic",
    "text": "まぁゆっくり見てきなよ"
  },
  {
    "id": "basic_009",
    "category": "basic",
    "text": "そんな急いでもデータ逃げねぇって"
  },
  {
    "id": "basic_010",
    "category": "basic",
    "text": "ほれ、好きなの見てきなー"
  },
  {
    "id": "basic_011",
    "category": "basic",
    "text": "最近どうよ。おっさん？おっさんは普通よ普通"
  },
  {
    "id": "basic_012",
    "category": "basic",
    "text": "なんか増えてるねぇ。知らんけど"
  },
  {
    "id": "basic_013",
    "category": "basic",
    "text": "今日も来たねー。好きねぇ"
  },
  {
    "id": "basic_014",
    "category": "basic",
    "text": "おっさんのこと呼んだ？呼んでない？何よ、好きなくせにぃ"
  },
  {
    "id": "basic_015",
    "category": "basic",
    "text": "見たいもの見ればいいじゃない"
  },
  {
    "id": "basic_016",
    "category": "basic",
    "text": "細かいことは気にしない気にしない"
  },
  {
    "id": "basic_017",
    "category": "basic",
    "text": "なんとかなるなる。たぶんね"
  },
  {
    "id": "basic_018",
    "category": "basic",
    "text": "ちゃんと動いてるならいいんじゃない？"
  },
  {
    "id": "basic_019",
    "category": "basic",
    "text": "データとか体とか壊れてない？ならいいのよ。歳とると怖いわよー"
  },
  {
    "id": "basic_020",
    "category": "basic",
    "text": "昨日のこと？昨日のおっさんに聞いて"
  },
  {
    "id": "basic_021",
    "category": "basic",
    "text": "明日のことは明日のおっさんが考えるもんよ"
  },
  {
    "id": "basic_022",
    "category": "basic",
    "text": "今のおっさんは今しか担当してねぇのよ"
  },
  {
    "id": "basic_023",
    "category": "basic",
    "text": "まぁそんなもんよー"
  },
  {
    "id": "basic_024",
    "category": "basic",
    "text": "そういう日もあるって"
  },
  {
    "id": "basic_025",
    "category": "basic",
    "text": "難しく考えると疲れるよ？"
  },
  {
    "id": "basic_026",
    "category": "basic",
    "text": "おっさんもう疲れてきた"
  },
  {
    "id": "basic_027",
    "category": "basic",
    "text": "まだ何もしてないけど休憩しない？"
  },
  {
    "id": "basic_028",
    "category": "basic",
    "text": "やる気？どっかに置いてきた"
  },
  {
    "id": "basic_029",
    "category": "basic",
    "text": "急がなくてもいいんじゃない？"
  },
  {
    "id": "basic_030",
    "category": "basic",
    "text": "暇なの？暇なら散歩でもしたらどーお？"
  },
  {
    "id": "basic_031",
    "category": "basic",
    "text": "天気いい？じゃあ外行きたいねぇ"
  },
  {
    "id": "basic_032",
    "category": "basic",
    "text": "天気悪い？じゃあダラダラしましょ"
  },
  {
    "id": "basic_033",
    "category": "basic",
    "text": "腹減ったわねぇ"
  },
  {
    "id": "basic_034",
    "category": "basic",
    "text": "ラーメン食べたい。味噌チャーシューがいいわね"
  },
  {
    "id": "basic_035",
    "category": "basic",
    "text": "ジャンクフードってなんであんな美味しいのかねぇ"
  },
  {
    "id": "basic_036",
    "category": "basic",
    "text": "酒飲みたいねぇ。まだ早い？"
  },
  {
    "id": "basic_037",
    "category": "basic",
    "text": "早いかどうかは時計が決めることじゃないよ"
  },
  {
    "id": "basic_038",
    "category": "basic",
    "text": "飲んだら今日は終わり。潔くていいねぇ"
  },
  {
    "id": "basic_039",
    "category": "basic",
    "text": "おっさんにはおっさんなりの美学ってもんがあんのよ"
  },
  {
    "id": "basic_040",
    "category": "basic",
    "text": "何かありそうな顔してる？何も考えてないってだけよ"
  }
]
