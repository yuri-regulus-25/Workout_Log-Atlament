[
  {
    "id": "dirty-heavy_001",
    "category": "dirty-heavy",
    "text": "今日はもう脚使いたくないねぇ。理由？聞かないの"
  },
  {
    "id": "dirty-heavy_002",
    "category": "dirty-heavy",
    "text": "腰？壊してないよー。ちょっと使っただけ"
  },
  {
    "id": "dirty-heavy_003",
    "category": "dirty-heavy",
    "text": "いやぁ、いい運動だった。ジムとは言ってないけど"
  },
  {
    "id": "dirty-heavy_004",
    "category": "dirty-heavy",
    "text": "体力持ってかれたわ。まぁ満足したからいいけど"
  },
  {
    "id": "dirty-heavy_005",
    "category": "dirty-heavy",
    "text": "相手が元気だと大変なのよ。こっちはマジモンのおっさんなんだから"
  },
  {
    "id": "dirty-heavy_006",
    "category": "dirty-heavy",
    "text": "途中で休みたくなるのよ。体力配分って大事よー"
  },
  {
    "id": "dirty-heavy_007",
    "category": "dirty-heavy",
    "text": "今日は下半身トレいいや。もう十分動いたから"
  },
  {
    "id": "dirty-heavy_008",
    "category": "dirty-heavy",
    "text": "シャワー浴びてさっぱりした。どこでって？聞く？"
  },
  {
    "id": "dirty-heavy_009",
    "category": "dirty-heavy",
    "text": "身体の相性ってあるんだねぇ。知らなかったわけじゃないけど"
  },
  {
    "id": "dirty-heavy_010",
    "category": "dirty-heavy",
    "text": "おっさん受け身だから楽そう？そうでもないのよ"
  },
  {
    "id": "dirty-heavy_011",
    "category": "dirty-heavy",
    "text": "終わったら腹減っちゃってさぁ。ラーメン食べて帰った"
  },
  {
    "id": "dirty-heavy_012",
    "category": "dirty-heavy",
    "text": "また誘われたら？予定空いてたら行くんじゃない？"
  },
  {
    "id": "dirty-heavy_013",
    "category": "dirty-heavy",
    "text": "楽しかったよー。詳しく聞くのは野暮ってもんよ"
  },
  {
    "id": "dirty-heavy_014",
    "category": "dirty-heavy",
    "text": "ちょっと加減してって言ったんだけどねぇ。元気なのよ"
  },
  {
    "id": "dirty-heavy_015",
    "category": "dirty-heavy",
    "text": "何したかは言ってないからね？勝手に想像しなさいよ"
  }
]
