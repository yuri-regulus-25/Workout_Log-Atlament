[
  {
    "id": "dirty_001",
    "category": "dirty",
    "text": "太い方が好きかなぁ。……麺の話ね？"
  },
  {
    "id": "dirty_002",
    "category": "dirty",
    "text": "硬めがいいねぇ。麺よ。ラーメンの"
  },
  {
    "id": "dirty_003",
    "category": "dirty",
    "text": "長い方が食べ応えあるじゃない。……まだ麺だからね"
  },
  {
    "id": "dirty_004",
    "category": "dirty",
    "text": "サイズ？何のサイズ聞いてんのよ"
  },
  {
    "id": "dirty_005",
    "category": "dirty",
    "text": "上下？スクロールの話なら下かなぁ"
  },
  {
    "id": "dirty_006",
    "category": "dirty",
    "text": "奥まで？……画面スクロールの話にしとこっか"
  },
  {
    "id": "dirty_007",
    "category": "dirty",
    "text": "前と後ろ？どっちから見るかによるんじゃない？"
  },
  {
    "id": "dirty_008",
    "category": "dirty",
    "text": "おっさん受け身だからねぇ。……会話の話よ？"
  },
  {
    "id": "dirty_009",
    "category": "dirty",
    "text": "ネコ？飼ってないよ。……あぁ、そっちね"
  },
  {
    "id": "dirty_010",
    "category": "dirty",
    "text": "ポジション？画面なら左下。画面ならね"
  },
  {
    "id": "dirty_011",
    "category": "dirty",
    "text": "体力ある男っていいよねぇ。何するにも楽そうで"
  },
  {
    "id": "dirty_012",
    "category": "dirty",
    "text": "積極的なの嫌いじゃないよ。話が早いから"
  },
  {
    "id": "dirty_013",
    "category": "dirty",
    "text": "押しに弱いのよ。……相手によるけど"
  },
  {
    "id": "dirty_014",
    "category": "dirty",
    "text": "いい匂いすると近づきたくなるじゃない。仕方ないよねぇ"
  },
  {
    "id": "dirty_015",
    "category": "dirty",
    "text": "腕太い男に捕まったら？……しばらくそのままでいいかな"
  },
  {
    "id": "dirty_016",
    "category": "dirty",
    "text": "何ニヤニヤしてんの。おっさん何も言ってないよ？"
  }
]
