{
  "name": "@workout-lab/vesria",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:logo": "vite --config logo-playground/vite.config.ts",
    "check:logo": "tsc -p logo-playground/tsconfig.json",
    "build:logo": "tsc -p logo-playground/tsconfig.json && vite build --config logo-playground/vite.config.ts",
    "dev:theme": "vite --config theme-playground/vite.config.ts",
    "check:theme": "tsc -p theme-playground/tsconfig.json",
    "build:theme": "tsc -p theme-playground/tsconfig.json && vite build --config theme-playground/vite.config.ts",
    "dev": "vite --host 127.0.0.1 --port 5184",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5185 --strictPort"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "@workout-lab/frontend-common": "file:../../shared/frontend-common",
    "@workout-lab/workout-core": "file:../../shared/workout-core",
    "@workout-lab/workout-data": "file:../../shared/workout-data",
    "@workout-lab/workout-types": "file:../../shared/workout-types",
    "apexcharts": "^6.9.0",
    "d3-force": "^3.0.0",
    "motion": "^13.4.4",
    "react": "^19.2.8",
    "react-apexcharts": "^1.9.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
