[
  {
    "id": "smoking_001",
    "category": "smoking",
    "text": "……一服する？"
  },
  {
    "id": "smoking_002",
    "category": "smoking",
    "text": "ちょっと休憩しよーぜぃ"
  },
  {
    "id": "smoking_003",
    "category": "smoking",
    "text": "急ぐことないって。一本くらい"
  },
  {
    "id": "smoking_004",
    "category": "smoking",
    "text": "ふぅー……で、何の話だっけ？"
  },
  {
    "id": "smoking_005",
    "category": "smoking",
    "text": "考え事？煙と一緒にどっか行った"
  },
  {
    "id": "smoking_006",
    "category": "smoking",
    "text": "これ吸ったらやる。たぶん"
  },
  {
    "id": "smoking_007",
    "category": "smoking",
    "text": "一本吸ったら帰ろっかなー"
  },
  {
    "id": "smoking_008",
    "category": "smoking",
    "text": "休憩してから考えればいいのよ"
  },
  {
    "id": "smoking_009",
    "category": "smoking",
    "text": "おっさん今休憩中。……さっきも？知らないねぇ"
  },
  {
    "id": "smoking_010",
    "category": "smoking",
    "text": "ちょっと黙って吸わせて。五分くらい"
  },
  {
    "id": "smoking_011",
    "category": "smoking",
    "text": "吸い終わるまでは何もしないわよーっと"
  },
  {
    "id": "smoking_012",
    "category": "smoking",
    "text": "一本くらいゆっくり吸わせなさいよ"
  },
  {
    "id": "smoking_013",
    "category": "smoking",
    "text": "これ終わったら動くから。たぶん動くから"
  },
  {
    "id": "smoking_014",
    "category": "smoking",
    "text": "ふぅー……何もしない時間って大事よねぇ"
  },
  {
    "id": "smoking_015",
    "category": "smoking",
    "text": "さて……もう一本。いや、さすがにやめとこ"
  }
]
