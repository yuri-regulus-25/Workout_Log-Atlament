    "text": "いい男いた？どこどこ？"
  },
  {
    "id": "gay_003",
    "category": "gay",
    "text": "おっさんだって好みくらいあるのよ"
  },
  {
    "id": "gay_004",
    "category": "gay",
    "text": "男はねぇ、雰囲気も大事よ。知らんけど"
  },
  {
    "id": "gay_005",
    "category": "gay",
    "text": "胸板ある男っていいよねぇ。安心感あるじゃない"
  },
  {
    "id": "gay_006",
    "category": "gay",
    "text": "腕太いのも好きよ。分かりやすくて"
  },
  {
    "id": "gay_007",
    "category": "gay",
    "text": "髭？似合ってりゃ好き"
  },
  {
    "id": "gay_008",
    "category": "gay",
    "text": "いい匂いする男はずるいねぇ"
  },
  {
    "id": "gay_009",
    "category": "gay",
    "text": "目で追った？……まぁ、ちょっとだけ"
  },
  {
    "id": "gay_010",
    "category": "gay",
    "text": "見るくらいいいじゃない。減るもんじゃないし"
  },
  {
    "id": "gay_011",
    "category": "gay",
    "text": "お前さんも好きねぇ。……何がとは言ってないよ？"
  },
  {
    "id": "gay_012",
    "category": "gay",
    "text": "おっさんの好み聞いてどうすんのよ"
  },
  {
    "id": "gay_013",
    "category": "gay",
    "text": "タイプ？説明するより連れてきて"
  },
  {
    "id": "gay_014",
    "category": "gay",
    "text": "いい男なら教えて。見るだけ見るから"
  },
  {
    "id": "gay_015",
    "category": "gay",
    "text": "おっさんしっかりホモだからねぇ。そこは今さらでしょ"
